<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Inheriting from Spring Boot's parent gives every module tested, compatible versions of all Spring libraries -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>exercises</groupId>
    <artifactId>spring</artifactId>
    <version>1.0-SNAPSHOT</version>
    <!-- "pom" packaging: this project produces no jar of its own, it just groups the exercise modules -->
    <packaging>pom</packaging>

    <properties>
        <java.version>21</java.version>
    </properties>

    <modules>
        <module>sb01-first-endpoints</module>
        <module>sb02-dependency-injection</module>
        <module>sb03-configuration</module>
        <module>sb04-rest-crud</module>
        <module>sb05-validation-errors</module>
        <module>sb06-jpa</module>
        <module>sb07-relationships-transactions</module>
        <module>sb08-flyway-postgres</module>
        <module>sb09-security</module>
        <module>sb10-production</module>
    </modules>
</project>
